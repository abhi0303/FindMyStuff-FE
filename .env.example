# ---------------------------------------------------------------------------
# The API origin the app calls DIRECTLY from the browser.
#
# Leave EMPTY in dev: requests then go to /api on the dev origin and Vite proxies
# them server-side. That is why the network tab shows localhost:5173 — it is a
# proxy hop, not a different backend. It keeps the browser same-origin, so there
# is no CORS dependency and no preflight round-trip.
#
# Set it if you would rather the browser call the API directly (the network tab
# then shows the real URL). The API's CORS_ORIGINS must list your dev origin
# exactly — note that Vite falls back to 5174/5175 when 5173 is taken, which
# would then be rejected.
#
#   VITE_API_BASE_URL=https://findmystuff-api-b3so.onrender.com/api
#
# Production builds have no proxy, so this is set in .env.production.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# Dev only: where the Vite proxy forwards /api.
#   deployed backend : https://findmystuff-api-b3so.onrender.com
#   local backend    : http://localhost:3000
# ---------------------------------------------------------------------------
API_PROXY_TARGET=https://findmystuff-api-b3so.onrender.com
